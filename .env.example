# QE Copilot — environment configuration template.
# Copy to `.env` and adjust. NEVER commit a real `.env` (see .gitignore).
# Every variable the services read is documented here.

# --- Service identity ---
SERVICE_NAME=qe-copilot
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (pgvector) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=qe_copilot
POSTGRES_PASSWORD=qe_copilot
POSTGRES_DB=qe_copilot

# --- Redis (Celery broker/backend + cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- MinIO / S3-compatible object storage ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=qe-copilot

# --- Frontend (Next.js) ---
# Base URL the web app uses to reach the API (browser-visible).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# TODO(phase-2): AI provider credentials (kept out of source; injected at deploy).
# ANTHROPIC_API_KEY=
# TODO(phase-6): GitHub App credentials for webhook ingestion.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
