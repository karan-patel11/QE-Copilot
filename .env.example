# QE Copilot — environment configuration template.
# Copy to `.env` and adjust. NEVER commit a real `.env` (see .gitignore).
# Every variable the services read is documented here.

# --- Service identity ---
SERVICE_NAME=qe-copilot
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (pgvector) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=qe_copilot
POSTGRES_PASSWORD=qe_copilot
POSTGRES_DB=qe_copilot

# --- Redis (Celery broker/backend + cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- MinIO / S3-compatible object storage ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=qe-copilot

# --- Authentication (ADR-0101/0102/0103) ---
# Signing key for platform access tokens. The value below is a placeholder;
# generate a real one (`openssl rand -hex 32`) for any shared environment.
# ENVIRONMENT=production refuses to start while it is unchanged.
AUTH_SECRET_KEY=dev-insecure-change-me
AUTH_ISSUER=qe-copilot
AUTH_AUDIENCE=qe-copilot-api
AUTH_TOKEN_TTL_SECONDS=3600
# Dev-mode identity provider: mounts POST /api/v1/auth/dev/login. MUST be false
# when ENVIRONMENT=production (enforced by Settings validation).
AUTH_DEV_MODE=true
AUTH_DEV_ADMIN_EMAIL=admin@example.com
AUTH_DEV_ORGANISATION_SLUG=default
# Browser origins allowed to call the API (comma-separated, never "*").
# Defaults cover local dev (:3000) and the Playwright server (:3100).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100

# --- Frontend (Next.js) ---
# Base URL the web app uses to reach the API (browser-visible).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# TODO(phase-2): AI provider credentials (kept out of source; injected at deploy).
# ANTHROPIC_API_KEY=
# TODO(phase-6): GitHub App credentials for webhook ingestion.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
